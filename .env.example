# Optional settings: copy to .env and fill in locally. Never commit .env.
# Without GROQ_API_KEY (or with AI_ENABLED=false) the tool runs fully on deterministic rules.
GROQ_API_KEY=
# Free-tier model with strict JSON-schema support (llama-3.3-70b-versatile is Enterprise-only on Groq).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# auto = strict json_schema for gpt-oss models, json_object otherwise.
GROQ_RESPONSE_FORMAT=auto
AI_ENABLED=true
AI_CHECK_MODEL=true
AI_SKIP_THREATS=true
AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.2
AI_MAX_COMPLETION_TOKENS=2048
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
# The free tier allows ~8K tokens/minute, so pacing may need to wait up to a minute.
AI_MAX_BACKOFF_SECONDS=60
# Caches validated model output in .cache/ai so re-runs do not repeat API calls.
AI_CACHE_ENABLED=true
# Optional YYYY-MM-DD override for "today"; defaults to the creator profile's "today" field.
REFERENCE_DATE=
